{
  "name": "kafka-server",
  "version": "1.0.0",
  "private": true,
  "description": "Docker images with Kafka to be used in testing/development environments",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.6.0"
  },
  "scripts": {
    "docker:build": "docker build -t ${KAFKA_IMAGE:-kafka-test} --build-arg KAFKA_VERSION=${KAFKA_VERSION:-4.4.0} .",
    "docker:run": "docker run --name kafka-local -d -p 9092:9092 -e KAFKA__NUM_PARTITIONS=2 ${KAFKA_IMAGE:-kafka-test}",
    "docker:wait": "until [ \"$(docker inspect -f '{{.State.Health.Status}}' kafka-local)\" = healthy ]; do sleep 1; done",
    "docker:stop": "docker rm -f -v kafka-local || true",
    "test": "vitest run"
  },
  "devDependencies": {
    "@platformatic/kafka": "2.14.0",
    "vitest": "5.0.5"
  }
}
